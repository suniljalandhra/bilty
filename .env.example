# Set in the shell; files are not loaded automatically.
DATABASE_URL=postgresql://bilty:bilty-local-only@localhost:55432/bilty
# Integration tests DROP and recreate the schema at this URL. Use a disposable DB.
BILTY_TEST_DATABASE_URL=postgresql://bilty:bilty-local-only@localhost:55432/bilty_test
BILTY_TEST_ALLOW_RESET=yes

# Docker development database (Compose reads .env automatically).
DB_PORT=55432
DB_USER=bilty
DB_PASSWORD=bilty-local-only
DB_NAME=bilty
