# Docker Compose reads .env. Host Node commands require exported variables.
DATABASE_URL=postgresql://bilty:bilty-local-only@localhost:55432/bilty
DB_PORT=55432
DB_USER=bilty
DB_PASSWORD=bilty-local-only
DB_NAME=bilty
API_PORT=3000
WEB_PORT=3001
PUBLIC_API_URL=http://localhost:3000
PORT=3000
NODE_ENV=development
# Create a Google OAuth web client and register this exact redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
FRONTEND_URL=http://localhost:3001
# Generate locally with: openssl rand -hex 32
JWT_SECRET=
# Prefer pnpm test:docker, which sets isolated test variables automatically.
# Low-level integration tests DROP/RECREATE the selected schema.
# BILTY_TEST_DATABASE_URL=postgresql://.../disposable_test_database
# BILTY_TEST_ALLOW_RESET=yes
